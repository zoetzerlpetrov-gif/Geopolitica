{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoetzerlpetrov-gif.github.io/Geopolitica/schema/event.schema.json",
  "title": "Archivo de eventos geopolíticos (data/events.json)",
  "description": "Contrato de datos. GitHub Actions valida events.json contra este esquema antes de publicar; si falla, no se publica.",
  "type": "object",
  "required": ["version_esquema", "generado_utc", "total", "eventos"],
  "additionalProperties": false,
  "properties": {
    "version_esquema": {"const": "1.0"},
    "generado_utc": {"type": "string", "format": "date-time"},
    "modo": {"enum": ["ejemplo", "produccion"]},
    "total": {"type": "integer", "minimum": 0},
    "eventos": {"type": "array", "items": {"$ref": "#/$defs/evento"}}
  },
  "$defs": {
    "area_id": {"enum": ["geografia", "seguridad", "geoeconomia", "energia", "tecnologia", "demografia", "clima", "instituciones", "identidad", "regional", "riesgo"]},
    "region_id": {"enum": ["norteamerica", "centroamerica_caribe", "sudamerica", "europa_occidental", "europa_este_rusia", "medio_oriente", "africa_norte_sahel", "africa_subsahariana", "asia_central", "asia_sur", "indopacifico_taiwan", "artico", null]},
    "tipo_fuente": {"enum": ["noticia", "base_datos", "red_social", "analisis"]},
    "fuente_ref": {
      "type": "object",
      "required": ["fuente", "url", "tipo_fuente"],
      "additionalProperties": false,
      "properties": {
        "fuente": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "tipo_fuente": {"$ref": "#/$defs/tipo_fuente"},
        "fecha_utc": {"type": "string", "format": "date-time"}
      }
    },
    "evento": {
      "type": "object",
      "required": ["id", "fecha_utc", "titulo", "resumen", "fuente", "url", "tipo_fuente", "pais_iso3", "region", "lat", "lon", "area_principal", "areas_secundarias", "subtemas", "actores", "severidad", "confianza_clasificacion", "verificado", "impacto_mexico", "fuentes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
        "fecha_utc": {"type": "string", "format": "date-time"},
        "titulo": {"type": "string", "minLength": 5, "maxLength": 300},
        "resumen": {"type": "string", "maxLength": 400, "description": "Máximo 2 frases, redactado por el sistema (nunca el texto del artículo)."},
        "fuente": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "tipo_fuente": {"$ref": "#/$defs/tipo_fuente"},
        "pais_iso3": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "region": {"$ref": "#/$defs/region_id"},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "area_principal": {"$ref": "#/$defs/area_id"},
        "areas_secundarias": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/area_id"}},
        "subtemas": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "actores": {"type": "array", "items": {"type": "string"}},
        "severidad": {"type": "integer", "minimum": 1, "maximum": 5},
        "confianza_clasificacion": {"type": "number", "minimum": 0, "maximum": 1},
        "verificado": {"type": "boolean"},
        "impacto_mexico": {"type": ["string", "null"]},
        "fuentes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fuente_ref"}, "description": "Todas las fuentes agrupadas por la deduplicación. La primera coincide con fuente/url."},
        "es_ejemplo": {"type": "boolean"}
      }
    }
  }
}
